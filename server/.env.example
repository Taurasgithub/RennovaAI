# Copy to .env (never commit it)

# Which image provider to use: cloudflare | openrouter | openai
# (if unset: OpenRouter when its key is set, then Cloudflare, then OpenAI)
IMAGE_PROVIDER=cloudflare

# Cloudflare Workers AI — free daily allowance (FLUX.2 klein edits your room photo)
# Account ID: dash.cloudflare.com → Workers AI → "Use REST API". Token permissions: Workers AI Read + Edit.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-2-klein-9b

# OpenRouter (paid, ~$0.04/image): best at keeping the room's layout
OPENROUTER_API_KEY=
OPENROUTER_IMAGE_MODEL=google/gemini-2.5-flash-image

# OpenAI (paid)
# OPENAI_API_KEY=
# IMAGE_MODEL=gpt-image-1
# OPENAI_BASE_URL=https://api.openai.com/v1

# Output settings
IMAGE_SIZE=1536x1024
IMAGE_QUALITY=medium
PORT=8080
RATE_LIMIT_PER_HOUR=30
