# Copy to .env and fill in. EXPO_PUBLIC_* values are embedded in the app at build time —
# never put secret keys here. The OpenAI key goes in server/.env only.
EXPO_PUBLIC_API_URL=https://api.rennovaai.com
EXPO_PUBLIC_SUPPORT_WHATSAPP=923000000000
EXPO_PUBLIC_SUPPORT_EMAIL=support@rennovaai.com
EXPO_PUBLIC_PRIVACY_URL=https://rennovaai.com/privacy
EXPO_PUBLIC_TERMS_URL=https://rennovaai.com/terms
