
# Accounts (Supabase). Leave empty to run without sign-in (on-device mode). See supabase/README.md.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set to true once Apple's web sign-in (Services ID + secret) is configured, to show the Apple button on Android/web.
EXPO_PUBLIC_APPLE_WEB_SIGNIN=false
# AI preview API: the deployed Cloudflare Worker (worker/README.md), or http://<your-PC-IP>:8080 for the local /server.
# Leave empty to use the on-device colour preview only.
EXPO_PUBLIC_API_URL=
# Public pages served by the Worker; Google Play needs the privacy-policy URL.
EXPO_PUBLIC_PRIVACY_URL=
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_SUPPORT_EMAIL=
EXPO_PUBLIC_SUPPORT_WHATSAPP=
# Paid Premium Design Pack. Keep false until Google Play Billing is integrated.
EXPO_PUBLIC_PREMIUM=false
