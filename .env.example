
# Accounts (Supabase). Leave empty to run without sign-in (on-device mode). See supabase/README.md.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Set to true once Apple's web sign-in (Services ID + secret) is configured, to show the Apple button on Android/web.
EXPO_PUBLIC_APPLE_WEB_SIGNIN=false
